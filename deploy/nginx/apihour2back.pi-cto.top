server {
    server_name apihour2back.pi-cto.top;

    client_max_body_size 10M;

    # NB : l'Optiplex héberge plusieurs apps, chacune sur son propre port (voir
    # /etc/apihour2/apihour2.env -> SERVER_PORT). Adapter si ça change un jour.
    location /api/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/apihour2back.pi-cto.top/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/apihour2back.pi-cto.top/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}
server {
    if ($host = apihour2back.pi-cto.top) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name apihour2back.pi-cto.top;
    return 404; # managed by Certbot
}
